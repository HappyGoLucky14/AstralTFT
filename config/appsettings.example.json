{
  "Performance": {
    "Mode": "Auto",
    "PreferNoTftImpact": true,
    "MaxDetectorQueueDepth": 2,
    "UseGpuWhenBeneficial": true,
    "AllowLargeAssetCacheMb": 768
  },
  "Recognition": {
    "SaveFailedFrames": true,
    "FailedFrameRetentionDays": 14,
    "UnknownThreshold": 0.60,
    "ProbableThreshold": 0.85,
    "ConfirmedThreshold": 0.97
  },
  "Theme": {
    "Mode": "Adaptive",
    "BaseStyle": "PurpleAstral",
    "HoverExpansionEnabled": true,
    "GlassEffectsEnabled": false
  },
  "Storage": {
    "KeepGameHistoryIndefinitely": true,
    "CloudBackupEnabled": false
  }
}
