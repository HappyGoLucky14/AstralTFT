<Window x:Class="AstralTFT.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AstralTFT"
        Width="500" Height="760"
        MinWidth="410" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="ASTRALTFT" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/>
                <TextBlock Text="Capture Diagnostics" FontSize="25" FontWeight="SemiBold" Margin="0,2,0,0"/>
                <TextBlock Text="Windows Graphics Capture ROI benchmark build" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/>
            </StackPanel>
            <Border Grid.Column="1" CornerRadius="999" Background="{StaticResource Panel2Brush}" Padding="10,6" VerticalAlignment="Top">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="8" Height="8" Fill="{Binding StatusBrush}" Margin="0,0,7,0"/>
                    <TextBlock Text="{Binding StatusText}" FontSize="12"/>
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="{StaticResource PanelBrush}" CornerRadius="14" Padding="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="TFT WINDOW" FontSize="11" Foreground="{StaticResource MutedBrush}" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding WindowTitle}" FontSize="17" FontWeight="SemiBold" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding WindowDetails}" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/>
                </StackPanel>
                <Border Grid.Column="1" Background="#239B6DFF" CornerRadius="10" Padding="11,8" VerticalAlignment="Center" Margin="14,0,0,0">
                    <TextBlock Text="{Binding ResolutionText}" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold"/>
                </Border>
            </Grid>
        </Border>

        <Border Grid.Row="4" Background="{StaticResource PanelBrush}" CornerRadius="14" Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="WINDOWS GRAPHICS CAPTURE" FontSize="11" Foreground="{StaticResource MutedBrush}" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding CaptureState}" FontSize="17" FontWeight="SemiBold" Margin="0,6,0,0"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding CaptureRateText}" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </Grid>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="GPU→CPU readback" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                        <TextBlock Text="{Binding ReadbackText}" FontWeight="SemiBold" Margin="0,3,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Back-pressure" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                        <TextBlock Text="{Binding DropText}" FontWeight="SemiBold" Margin="0,3,0,0"/>
                    </StackPanel>
                </Grid>

                <TextBlock Grid.Row="4" Text="{Binding CaptureDetails}" Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap"/>
            </Grid>
        </Border>

        <Border Grid.Row="6" Background="{StaticResource PanelBrush}" CornerRadius="14" Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="14"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="PIPELINE" FontSize="11" Foreground="{StaticResource MutedBrush}" FontWeight="SemiBold"/>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Window discovery" FontWeight="SemiBold"/>
                        <TextBlock Text="Finds the TFT HWND without reading game memory" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,3,0,0"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding DiscoveryState}" Foreground="{StaticResource GoodBrush}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                </Grid>

                <Grid Grid.Row="4">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="WGC + D3D11 readback" FontWeight="SemiBold"/>
                        <TextBlock Text="TFT-only capture, ROI readback, newest-frame queue" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,3,0,0"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="IMPLEMENTED" Foreground="{StaticResource GoodBrush}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                </Grid>

                <Grid Grid.Row="6">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Shop structure recognition" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding RecognitionDetails}" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,3,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding RecognitionState}" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Row="8" Background="#189B6DFF" BorderBrush="#409B6DFF" BorderThickness="1" CornerRadius="12" Padding="13">
            <TextBlock Text="{Binding FooterText}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" FontSize="12"/>
        </Border>
    </Grid>
</Window>
